@page
@model AddModel
@{
    ViewData["Title"] = "Add Item";
    ViewData["WrapClass"] = "form-page";
}

<div class="compact-header">
    <div class="compact-header-row">
        <div>
            <h1>Add Item</h1>
            <p class="page-subtitle">Core details on the left — photo on the side. Optional sections collapse to save
                space.</p>
            </div>
            <a href="/" class="btn btn-light btn-small">← Back</a>
        </div>
</div>

    <div asp-validation-summary="All" class="flash error"></div>

<form method="post" id="itemForm" class="item-form" enctype="multipart/form-data">

        <div class="form-layout">

            <!-- Photo first on mobile, sticky sidebar on desktop -->
            <aside class="form-aside">
                <div class="form-panel photo-panel">
                    <div class="form-panel-head">
                        <h2>Primary Photo</h2>
                        <span class="form-panel-badge">Required</span>
                    </div>
                    <div class="camera-section">
                        <div id="cameraArea">
                            <video id="video" autoplay playsinline></video>
                            <canvas id="canvas" style="display:none;"></canvas>
                            <img id="preview" style="display:none;" alt="Captured preview" />
                        </div>
                        <div class="camera-buttons">
                            <button type="button" id="startCam" class="btn">Start</button>
                            <button type="button" id="captureBtn" class="btn btn-primary" disabled>Capture</button>
                            <button type="button" id="retakeBtn" class="btn btn-light" style="display:none;">Retake</button>
                        </div>
                        <p id="camError" class="cam-error"></p>

                        <button type="button" id="btnIdentify" class="btn btn-warning">🔍 Identify from photo</button>
                        <p id="identifyStatus" class="status-msg"></p>

                        <details class="url-details">
                            <summary>Or use image URL</summary>
                            <div class="url-fallback">
                                <label>
                                    Image URL
                                    <input type="url" id="imageUrlInput" placeholder="https://..." />
                                </label>
                                <button type="button" id="useUrlBtn" class="btn">Load URL</button>
                                <p id="urlError" class="cam-error"></p>
                            </div>
                        </details>

                        <input asp-for="Input.ImageData" type="hidden" id="image_data" />
                    </div>
                </div>
            </aside>

            <div class="form-main">

                <div class="form-panel">
                    <div class="form-panel-head">
                        <h2>Essentials</h2>
                    </div>
                    <div class="form-panel-body">

                        <div class="field-action-row">
                            <label>
                                Item Name *
                                <div class="suggest-wrap name-input-wrap">
                                    <input type="text" id="nameInput" required autocomplete="off" data-val="true"
                                           data-val-required="Item name is required." name="Input.Name" style="width: 100%;" />
                                    <div id="suggestBox" class="suggest-box" style="display: none;"></div>
                                </div>
                            </label>
                            <button type="button" id="btnEstimate" class="btn btn-warning btn-small">✨ Estimate ₹</button>
                        </div>
                        <p id="estimateStatus" class="status-msg"></p>

                        <div class="row2">
                            <label>
                                Category
                                <select asp-for="Input.CategoryId">
                                    <option value="">-- None --</option>
                                    @foreach (var top in Model.Categories.Where(c => c.ParentCategoryId == null))
                                    {
                                        <option value="@top.Id">@top.Name</option>
                                        @foreach (var child in top.Children)
                                        {
                                            <option value="@child.Id">&nbsp;&nbsp;&nbsp;&nbsp;↳ @child.Name</option>
                                        }
                                    }
                                </select>
                            </label>
                            <label>
                                Tags
                                <input asp-for="Input.TagsCsv" type="text" placeholder="gaming, spare, cable" />
                            </label>
                        </div>

                        <div class="row2">
                            <label>
                                Condition
                                <select asp-for="Input.ConditionId">
                                    <option value="">-- None --</option>
                                    @foreach (var top in Model.Conditions)
                                    {
                                        <option value="@top.Id">@top.Name</option>
                                    }
                                </select>
                            </label>
                            <label>
                                Location
                                <select asp-for="Input.LocationId">
                                    <option value="">-- None --</option>
                                    @foreach (var top in Model.Locations)
                                    {
                                        <option value="@top.Id">@top.Name</option>
                                    }
                                </select>
                            </label>
                        </div>

                        <div class="row3">
                            <label>
                                Current Price (₹) *
                                <input asp-for="Input.CurrentPrice" type="number" step="0.01" min="0" required />
                            </label>
                            <label>
                                Original Price (₹) *
                                <input asp-for="Input.OriginalPrice" type="number" step="0.01" min="0" required />
                            </label>
                            <label>
                                Quantity *
                                <input asp-for="Input.Quantity" type="number" step="1" min="0" required />
                            </label>
                        </div>

                        <label>
                            Notes
                            <textarea asp-for="Input.Notes" rows="2" placeholder="Optional notes..."></textarea>
                        </label>
                    </div>
                </div>

                <div class="form-accordions">

                    <details class="form-accordion">
                        <summary>Seller <span class="hint" style="margin:0;font-weight:400;">optional</span></summary>
                        <div class="form-accordion-body">
                            <label>
                                Existing seller
                                <select asp-for="Input.SellerId">
                                    <option value="">-- None / new seller below --</option>
                                    @foreach (var s in Model.Sellers)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                </select>
                            </label>
                            <div class="row2">
                                <label>
                                    Seller name
                                    <input asp-for="Input.NewSellerName" type="text" />
                                </label>
                                <label>
                                    Contact
                                    <input asp-for="Input.NewSellerContact" type="text" placeholder="phone / email" />
                                </label>
                            </div>
                            <label>
                                Link
                                <input asp-for="Input.NewSellerLink" type="url" placeholder="https://..." />
                            </label>
                        </div>
                    </details>

                    <details class="form-accordion">
                        <summary>Custom Attributes <span class="hint" style="margin:0;font-weight:400;">wattage,
                            warranty…</span></summary>
                            <div class="form-accordion-body">
                                <div id="attributeRows"></div>
                                <button type="button" id="addAttributeRow" class="btn btn-light btn-small">+ Add row</button>
                            </div>
                        </details>

                        <details class="form-accordion">
                            <summary>Extra Photos</summary>
                            <div class="form-accordion-body">
                                <div id="extraImagesPreview" class="extra-images-preview"></div>
                                <div class="camera-buttons">
                                    <button type="button" id="addExtraCam" class="btn btn-small">📷 Capture</button>
                                    <label class="btn btn-light btn-small" style="display:inline-flex;cursor:pointer;">
                                        Choose files
                                        <input type="file" id="extraImageFile" accept="image/*" multiple
                                               style="display:none;" />
                                    </label>
                                </div>
                                <div id="extraImageInputs"></div>
                            </div>
                        </details>

                        <details class="form-accordion">
                            <summary>Attachments</summary>
                            <div class="form-accordion-body">
                                <p class="hint">PDF, DOC, TXT, or images — manuals, invoices, spec sheets.</p>
                                <input type="file" name="Input.Attachments" multiple
                                       accept=".pdf,.doc,.docx,.txt,.png,.jpg,.jpeg" />
                            </div>
                        </details>

                    </div>
                </div>
            </div>

            <div class="form-footer">
                <a href="/" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Item</button>
            </div>
</form>

@section Scripts {
            <script>
                const video = document.getElementById('video');
                const canvas = document.getElementById('canvas');
                const preview = document.getElementById('preview');
                const startCam = document.getElementById('startCam');
                const captureBtn = document.getElementById('captureBtn');
                const retakeBtn = document.getElementById('retakeBtn');
                const imageDataInput = document.getElementById('image_data');
                const camError = document.getElementById('camError');
                const form = document.getElementById('itemForm');
                const btnEstimate = document.getElementById('btnEstimate');
                const estimateStatus = document.getElementById('estimateStatus');
                const currentPriceInput = document.querySelector('input[name="Input.CurrentPrice"]');
                const imageUrlInput = document.getElementById('imageUrlInput');
                const useUrlBtn = document.getElementById('useUrlBtn');
                const urlError = document.getElementById('urlError');
                const btnIdentify = document.getElementById('btnIdentify');
                const identifyStatus = document.getElementById('identifyStatus');
                let stream = null;

                startCam.addEventListener('click', async () => {
                    camError.textContent = '';
                    try {
                        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' }, audio: false });
                        video.srcObject = stream;
                        video.style.display = 'block';
                        preview.style.display = 'none';
                        startCam.disabled = true;
                        captureBtn.disabled = false;
                        retakeBtn.style.display = 'none';
                    } catch (err) {
                        camError.textContent = 'Camera access denied or unavailable: ' + err.message;
                    }
                });

                captureBtn.addEventListener('click', () => {
                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                    canvas.getContext('2d').drawImage(video, 0, 0);
                    const dataUrl = canvas.toDataURL('image/jpeg', 1.00);
                    imageDataInput.value = dataUrl;
                    preview.src = dataUrl;
                    preview.style.display = 'block';
                    video.style.display = 'none';
                    captureBtn.disabled = true;
                    retakeBtn.style.display = 'inline-block';
                    if (stream) stream.getTracks().forEach(t => t.stop());
                });

                retakeBtn.addEventListener('click', () => {
                    imageDataInput.value = '';
                    preview.style.display = 'none';
                    startCam.disabled = false;
                    captureBtn.disabled = true;
                    retakeBtn.style.display = 'none';
                    identifyStatus.textContent = '';
                });

                useUrlBtn.addEventListener('click', async () => {
                    urlError.textContent = '';
                    const url = imageUrlInput.value.trim();
                    if (!url) { urlError.textContent = 'Please enter an image URL.'; return; }

                    useUrlBtn.disabled = true;
                    const originalText = useUrlBtn.textContent;
                    useUrlBtn.textContent = 'Loading...';

                    try {
                        const img = new Image();
                        img.crossOrigin = 'anonymous';
                        await new Promise((resolve, reject) => {
                            img.onload = () => resolve(true);
                            img.onerror = () => reject(new Error('Could not load image from that URL.'));
                            img.src = url;
                        });
                        const c = document.createElement('canvas');
                        c.width = img.naturalWidth;
                        c.height = img.naturalHeight;
                        c.getContext('2d').drawImage(img, 0, 0);
                        const dataUrl = c.toDataURL('image/jpeg', 1.00);
                        imageDataInput.value = dataUrl;
                        preview.src = dataUrl;
                        preview.style.display = 'block';
                        video.style.display = 'none';
                        if (stream) stream.getTracks().forEach(t => t.stop());
                        startCam.disabled = false;
                        captureBtn.disabled = true;
                        retakeBtn.style.display = 'inline-block';
                        camError.textContent = '';
                    } catch (err) {
                        urlError.textContent = err.message;
                    } finally {
                        useUrlBtn.disabled = false;
                        useUrlBtn.textContent = originalText;
                    }
                });

                const nameInput = document.querySelector('input[name="Input.Name"]');

                btnEstimate.addEventListener('click', async () => {
                    estimateStatus.textContent = '';
                    if (!nameInput.value.trim()) {
                        estimateStatus.textContent = 'Enter an item name first.';
                        estimateStatus.style.color = 'var(--danger)';
                        return;
                    }
                    btnEstimate.disabled = true;
                    const originalText = btnEstimate.textContent;
                    btnEstimate.textContent = '…';
                    try {
                        const res = await fetch('/Add?handler=Estimate', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
                            body: JSON.stringify({ itemName: nameInput.value.trim() })
                        });
                        const data = await res.json();
                        if (data.success && data.price != null) {
                            currentPriceInput.value = data.price;
                            estimateStatus.textContent = 'Estimated: ₹' + data.price;
                            estimateStatus.style.color = 'var(--teal)';
                        } else {
                            estimateStatus.textContent = 'Could not estimate' + (data.error ? ': ' + data.error : '.');
                            estimateStatus.style.color = 'var(--danger)';
                        }
                    } catch (err) {
                        estimateStatus.textContent = 'Request failed: ' + err.message;
                        estimateStatus.style.color = 'var(--danger)';
                    } finally {
                        btnEstimate.disabled = false;
                        btnEstimate.textContent = originalText;
                    }
                });

                btnIdentify.addEventListener('click', async () => {
                    identifyStatus.textContent = '';
                    if (!imageDataInput.value) {
                        identifyStatus.textContent = 'Capture a photo first.';
                        identifyStatus.style.color = 'var(--danger)';
                        return;
                    }
                    btnIdentify.disabled = true;
                    const originalText = btnIdentify.textContent;
                    btnIdentify.textContent = 'Identifying…';
                    try {
                        const res = await fetch('/Add?handler=Identify', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
                            body: JSON.stringify({ imageData: imageDataInput.value })
                        });
                        const data = await res.json();
                        if (data.success && data.name) {
                            nameInput.value = data.name;
                            identifyStatus.textContent = 'Guess: ' + data.name;
                            identifyStatus.style.color = 'var(--teal)';
                            nameInput.dispatchEvent(new Event('input'));
                        } else {
                            identifyStatus.textContent = 'Could not identify' + (data.error ? ': ' + data.error : '.');
                            identifyStatus.style.color = 'var(--danger)';
                        }
                    } catch (err) {
                        identifyStatus.textContent = 'Request failed: ' + err.message;
                        identifyStatus.style.color = 'var(--danger)';
                    } finally {
                        btnIdentify.disabled = false;
                        btnIdentify.textContent = originalText;
                    }
                });

                function getAntiForgeryToken() {
                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    return tokenInput ? tokenInput.value : '';
                }

                form.addEventListener('submit', (e) => {
                    if (!imageDataInput.value) {
                        e.preventDefault();
                        camError.textContent = 'Please capture a photo before saving.';
                        document.querySelector('.form-aside').scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });

                const suggestBox = document.getElementById('suggestBox');
                let nameDebounce;

                nameInput.addEventListener('input', () => {
                    clearTimeout(nameDebounce);
                    const term = nameInput.value.trim();
                    if (term.length < 2) { suggestBox.style.display = 'none'; return; }
                    nameDebounce = setTimeout(async () => {
                        const res = await fetch(`/Add?handler=Suggest&term=${encodeURIComponent(term)}`);
                        const items = await res.json();
                        if (!items.length) { suggestBox.style.display = 'none'; return; }
                        suggestBox.innerHTML = items.map(i =>
                            `<div class="suggest-item" data-id="${i.id}">Exists: ${i.name} — click to edit</div>`
                        ).join('');
                        suggestBox.style.display = 'block';
                    }, 250);
                });

                suggestBox.addEventListener('click', (e) => {
                    const item = e.target.closest('.suggest-item');
                    if (item) window.location.href = `/Edit/${item.dataset.id}`;
                });

                document.addEventListener('click', (e) => {
                    if (!e.target.closest('#nameInput') && !e.target.closest('#suggestBox')) {
                        suggestBox.style.display = 'none';
                    }
                });

                const attributeRows = document.getElementById('attributeRows');
                document.getElementById('addAttributeRow').addEventListener('click', () => makeAttributeRow());

                function makeAttributeRow(key = '', value = '') {
                    const row = document.createElement('div');
                    row.className = 'attribute-row';
                    row.innerHTML = `
                                                                                        <input type="text" name="Input.AttributeKeys" placeholder="Key" value="${key}" />
                                                                                        <input type="text" name="Input.AttributeValues" placeholder="Value" value="${value}" />
                                                                                        <button type="button" class="btn btn-light btn-small remove-row">✕</button>`;
                    row.querySelector('.remove-row').addEventListener('click', () => row.remove());
                    attributeRows.appendChild(row);
                    row.closest('details')?.setAttribute('open', '');
                }

                const extraImagesPreview = document.getElementById('extraImagesPreview');
                const extraImageInputs = document.getElementById('extraImageInputs');

                function addExtraImageDataUrl(dataUrl) {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'extra-image-item';
                    const img = document.createElement('img');
                    img.src = dataUrl;
                    wrapper.appendChild(img);
                    const x = document.createElement('div');
                    x.className = 'remove-x';
                    x.textContent = '✕';
                    wrapper.appendChild(x);
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'Input.ExtraImageData';
                    hidden.value = dataUrl;
                    extraImageInputs.appendChild(hidden);
                    x.addEventListener('click', () => { wrapper.remove(); hidden.remove(); });
                    extraImagesPreview.appendChild(wrapper);
                    wrapper.closest('details')?.setAttribute('open', '');
                }

                document.getElementById('addExtraCam').addEventListener('click', async () => {
                    try {
                        const s = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' }, audio: false });
                        const v = document.createElement('video');
                        v.srcObject = s; v.autoplay = true; v.playsInline = true;
                        await new Promise(res => v.onloadedmetadata = res);
                        await new Promise(res => setTimeout(res, 400));
                        const c = document.createElement('canvas');
                        c.width = v.videoWidth; c.height = v.videoHeight;
                        c.getContext('2d').drawImage(v, 0, 0);
                        s.getTracks().forEach(t => t.stop());
                        addExtraImageDataUrl(c.toDataURL('image/jpeg', 0.92));
                    } catch (err) {
                        alert('Camera unavailable: ' + err.message);
                    }
                });

                document.getElementById('extraImageFile').addEventListener('change', (e) => {
                    [...e.target.files].forEach(file => {
                        const reader = new FileReader();
                        reader.onload = () => addExtraImageDataUrl(reader.result);
                        reader.readAsDataURL(file);
                    });
                    e.target.value = '';
                });


        
            </script>
        }

       