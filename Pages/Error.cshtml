@page
@{
    ViewData["Title"] = "Error";
    ViewData["WrapClass"] = "narrow";
}

<div class="error-page">
    <div class="error-icon">⚠️</div>
    <h1>Something went wrong</h1>
    <p>An unexpected error occurred while processing your request. Please try again or return to the inventory list.</p>
    <a href="/" class="btn btn-primary">← Back to Inventory</a>
</div>
