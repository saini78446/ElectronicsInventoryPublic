                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-danger btn-small" @(count == 0 ? "" : "disabled") title="@(count == 0 ? "Delete tag" : "Applied to items — remove it from those items first")">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Tags.Any())
                    {
                        <tr><td colspan="3" class="empty">No tags yet.</td></tr>
