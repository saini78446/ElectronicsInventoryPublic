else if (tab == "tags")
{
    <div class="manage-layout">
        <div class="form-panel add-panel">
            <div class="form-panel-head"><h2>Add Tag</h2></div>
            <form method="post" asp-page-handler="AddTag" class="form-panel-body">
                <label>
                    Name *
                    <input asp-for="NewTag.Name" type="text" required placeholder="e.g. gaming" />
                </label>
                <p class="hint">Tags are stored lowercase and must be unique.</p>
                <button type="submit" class="btn btn-primary btn-block">Add Tag</button>
            </form>
        </div>

        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Items</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Tags)
                    {
